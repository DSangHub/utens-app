import OpenAI from "openai";
const openai = new OpenAI({ apiKey: process.env.OPENAI_API_KEY! });

export type Intent = {
  intent: string;
  sentiment: "POSITIVE" | "NEUTRAL" | "NEGATIVE";
  confidence: number;
  needsEscalation: boolean;
};

export async function classifyComment(text: string): Promise<Intent> {
  const res = await openai.chat.completions.create({
    model: "gpt-4o-mini",
    response_format: { type: "json_object" },
    messages: [
      {
        role: "system",
        content: `Classify the customer comment. Return JSON: 
        { intent, sentiment, confidence (0-1), needsEscalation (bool) }.
        Escalate if: complaint, refund request, legal, angry tone, or confidence < 0.7.`,
      },
      { role: "user", content: text },
    ],
  });
  return JSON.parse(res.choices[0].message.content!);
}

export async function generateResponse(
  comment: string,
  scripts: { intent: string; response: string }[],
  brandVoice: string
): Promise<{ reply: string; confidence: number }> {
  const scriptBlock = scripts
    .map((s) => `[${s.intent}] ${s.response}`)
    .join("\n");

  const res = await openai.chat.completions.create({
    model: "gpt-4o",
    response_format: { type: "json_object" },
    messages: [
      {
        role: "system",
        content: `You are a brand assistant. Use ONLY the pre-scripted responses when they match.
Brand voice: ${brandVoice}
Scripts:\n${scriptBlock}
If no script matches well, say so and set confidence < 0.7. Return JSON: { reply, confidence }`,
      },
      { role: "user", content: comment },
    ],
  });
  return JSON.parse(res.choices[0].message.content!);
}

export async function holdMessage(customerName: string, brand: string) {
  const res = await openai.chat.completions.create({
    model: "gpt-4o-mini",
    messages: [
      {
        role: "system",
        content: `Write a warm, on-brand holding message (max 2 sentences) telling ${customerName} that ${brand} is checking and will reply soon.`,
      },
    ],
  });
  return res.choices[0].message.content!;
}
import { NextRequest, NextResponse } from "next/server";
import { prisma } from "@/lib/db";
import { classifyComment, generateResponse, holdMessage } from "@/lib/ai";
import { escalateToHost } from "@/lib/twilio";
import { postReply } from "@/lib/platforms";

export async function POST(req: NextRequest) {
  const { profileId, externalId, authorName, content } = await req.json();

  const profile = await prisma.profile.findUniqueOrThrow({
    where: { id: profileId },
    include: { org: { include: { scripts: true } } },
  });

  const comment = await prisma.comment.create({
    data: { profileId, externalId, authorName, content },
  });

  // 1. Classify
  const intent = await classifyComment(content);
  await prisma.comment.update({
    where: { id: comment.id },
    data: { intent: intent.intent, sentiment: intent.sentiment },
  });

  // 2. Generate AI response
  const { reply, confidence } = await generateResponse(
    content,
    profile.org.scripts,
    "friendly, professional, concise"
  );

  const shouldEscalate =
    intent.needsEscalation || confidence < 0.7 || !profile.autoReply;

  if (!shouldEscalate) {
    await postReply(profile.platform, profile.accessToken!, externalId, reply);
    await prisma.comment.update({
      where: { id: comment.id },
      data: {
        aiResponse: reply,
        finalResponse: reply,
        confidence,
        status: "AI_REPLIED",
        respondedAt: new Date(),
      },
    });
    return NextResponse.json({ status: "auto_replied", reply });
  }

  // 3. Escalate — send holding message + notify host
  const holding = await holdMessage(authorName, profile.org.name);
  await postReply(profile.platform, profile.accessToken!, externalId, holding);

  await escalateToHost({
    email: profile.escalationEmail,
    phone: profile.escalationPhone,
    comment: { authorName, content, intent: intent.intent },
    suggestedReply: reply,
    confidence,
    commentId: comment.id,
  });

  await prisma.comment.update({
    where: { id: comment.id },
    data: {
      aiResponse: reply,
      finalResponse: holding,
      confidence,
      status: "ESCALATED",
      escalatedAt: new Date(),
    },
  });

  return NextResponse.json({ status: "escalated", holding });
}import twilio from "twilio";
import { Resend } from "resend";

const client = twilio(process.env.TWILIO_SID!, process.env.TWILIO_TOKEN!);
const resend = new Resend(process.env.RESEND_API_KEY!);

export async function escalateToHost({
  email, phone, comment, suggestedReply, confidence, commentId,
}: any) {
  const body = `🔔 New ${comment.intent} from @${comment.authorName}:
"${comment.content}"

AI suggested: "${suggestedReply}" (${Math.round(confidence * 100)}%)

Reply: https://utens.app/inbox/${commentId}`;

  if (phone) {
    await client.messages.create({
      from: process.env.TWILIO_NUMBER!,
      to: phone,
      body,
    });
  }
  if (email) {
    await resend.emails.send({
      from: "alerts@utens.app",
      to: email,
      subject: `New ${comment.intent} needs your reply`,
      text: body,
    });
  }
