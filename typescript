import OpenAI from "openai";
const openai = new OpenAI({ apiKey: process.env.OPENAI_API_KEY! });

export type Intent = {
  intent: string;
  sentiment: "POSITIVE" | "NEUTRAL" | "NEGATIVE";
  confidence: number;
  needsEscalation: boolean;
};

export async function classifyComment(text: string): Promise<Intent> {
  const res = await openai.chat.completions.create({
    model: "gpt-4o-mini",
    response_format: { type: "json_object" },
    messages: [
      {
        role: "system",
        content: `Classify the customer comment. Return JSON: 
        { intent, sentiment, confidence (0-1), needsEscalation (bool) }.
        Escalate if: complaint, refund request, legal, angry tone, or confidence < 0.7.`,
      },
      { role: "user", content: text },
    ],
  });
  return JSON.parse(res.choices[0].message.content!);
}

export async function generateResponse(
  comment: string,
  scripts: { intent: string; response: string }[],
  brandVoice: string
): Promise<{ reply: string; confidence: number }> {
  const scriptBlock = scripts
    .map((s) => `[${s.intent}] ${s.response}`)
    .join("\n");

  const res = await openai.chat.completions.create({
    model: "gpt-4o",
    response_format: { type: "json_object" },
    messages: [
      {
        role: "system",
        content: `You are a brand assistant. Use ONLY the pre-scripted responses when they match.
Brand voice: ${brandVoice}
Scripts:\n${scriptBlock}
If no script matches well, say so and set confidence < 0.7. Return JSON: { reply, confidence }`,
      },
      { role: "user", content: comment },
    ],
  });
  return JSON.parse(res.choices[0].message.content!);
}

export async function holdMessage(customerName: string, brand: string) {
  const res = await openai.chat.completions.create({
    model: "gpt-4o-mini",
    messages: [
      {
        role: "system",
        content: `Write a warm, on-brand holding message (max 2 sentences) telling ${customerName} that ${brand} is checking and will reply soon.`,
      },
    ],
  });
  return res.choices[0].message.content!;
}
