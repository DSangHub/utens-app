// prisma/schema.prisma
generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql"; url = env("DATABASE_URL") }

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  phone         String?
  role          Role     @default(OWNER)
  orgId         String
  org           Organization @relation(fields: [orgId], references: [id])
  createdAt     DateTime @default(now())
}

enum Role { OWNER, ADMIN, AGENT }

model Organization {
  id            String   @id @default(cuid())
  name          String
  stripeCustomerId String? @unique
  plan          Plan     @default(FREE)
  users         User[]
  profiles      Profile[]
  scripts       Script[]
  createdAt     DateTime @default(now())
}

enum Plan { FREE, STARTER, PRO, ENTERPRISE }

model Profile {
  id            String   @id @default(cuid())
  orgId         String
  org           Organization @relation(fields: [orgId], references: [id])
  platform      Platform
  handle        String
  accessToken   String?
  refreshToken  String?
  autoReply     Boolean  @default(true)
  escalationEmail String?
  escalationPhone String?
  comments      Comment[]
  createdAt     DateTime @default(now())
}

enum Platform { INSTAGRAM, FACEBOOK, TIKTOK, YOUTUBE, X, LINKEDIN, GOOGLE }

model Script {
  id            String   @id @default(cuid())
  orgId         String
  org           Organization @relation(fields: [orgId], references: [id])
  intent        String   // e.g. "shipping_question", "pricing", "complaint"
  trigger       String[] // keywords or embeddings match
  response      String
  escalate      Boolean  @default(false)
  createdAt     DateTime @default(now())
}

model Comment {
  id            String   @id @default(cuid())
  profileId     String
  profile       Profile  @relation(fields: [profileId], references: [id])
  externalId    String
  authorName    String
  authorHandle  String?
  content       String
  intent        String?
  sentiment     Sentiment @default(NEUTRAL)
  status        Status   @default(PENDING)
  aiResponse    String?
  finalResponse String?
  confidence    Float?
  escalatedAt   DateTime?
  respondedAt   DateTime?
  createdAt     DateTime @default(now())
}

enum Sentiment { POSITIVE, NEUTRAL, NEGATIVE }
enum Status { PENDING, AI_REPLIED, ESCALATED, HUMAN_REPLIED, RESOLVED }

model Escalation {
  id            String   @id @default(cuid())
  commentId     String   @unique
  comment       Comment  @relation(fields: [commentId], references: [id])
  channel       String   // sms | email
  sentAt        DateTime @default(now())
  resolvedAt    DateTime?
  hostReply     String?
}model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String?
  name           String?
  phone          String?
  role           Role     @default(OWNER)
  orgId          String?
  org            Organization? @relation(fields: [orgId], references: [id])
  onboardStep    Int      @default(1)
  onboardDone    Boolean  @default(false)
  createdAt      DateTime @default(now())
}

model Organization {
  id             String   @id @default(cuid())
  name           String
  industry       String?
  brandVoice     String?
  stripeCustomerId String? @unique
  plan           Plan     @default(FREE)
  users          User[]
  profiles       Profile[]
  scripts        Script[]
  createdAt      DateTime @default(now())
  onboardedAt    DateTime?
}
model Organization {
  id                String   @id @default(cuid())
  name              String
  industry          String?
  brandVoice        String?
  stripeCustomerId  String?  @unique
  stripeSubId       String?  @unique
  plan              Plan     @default(TRIAL)
  trialEndsAt       DateTime?
  currentPeriodEnd  DateTime?
  users             User[]
  profiles          Profile[]
  scripts           Script[]
  products          Product[]         // Pro: catalog for promotion
  conversations     Conversation[]    // Pro: extended threads
  onboardedAt       DateTime?
  createdAt         DateTime @default(now())
}

enum Plan { TRIAL, STARTER, PRO, CANCELLED }

model Product {
  id          String   @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id])
  name        String
  description String
  price       Decimal  @db.Decimal(10, 2)
  url         String?
  imageUrl    String?
  keywords    String[] // matches comment intent to this product
  createdAt   DateTime @default(now())
}

model Conversation {
  id          String   @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id])
  commentId   String   @unique
  comment     Comment  @relation(fields: [commentId], references: [id])
  messages    ConversationMessage[]
  outcome     Outcome  @default(OPEN)
  purchaseAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum Outcome { OPEN, CONVERTED, LOST, HANDED_OFF }

model ConversationMessage {
  id             String   @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  role           String   // "customer" | "ai" | "host"
  content        String
  createdAt      DateTime @default(now())
}
model EmailLog {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id])
  stage    String
  sentAt   DateTime @default(now())
  @@unique([userId, stage])
}
model Organization {
  // ... existing
  stripeOverageItemId String?    // subscription item ID for the metered price
  repliesThisPeriod   Int        @default(0)
  periodStart         DateTime?
  periodEnd           DateTime?
  overageReportedAt   DateTime?
}

model UsageEvent {
  id        String   @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id])
  kind      String   // "reply" | "deep_turn"
  refId     String?  // commentId or conversationMessageId
  billable  Boolean  @default(false)
  createdAt DateTime @default(now())
  @@index([orgId, createdAt])
}
